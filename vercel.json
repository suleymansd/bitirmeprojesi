{
  "version": 2,
  "installCommand": "echo 'Skipping install: static frontend only'",
  "buildCommand": "echo 'No build required for static frontend'",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cilt-kanseri-teshisi-bitirme-production.up.railway.app/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/web/static/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/web/templates/index.html"
    }
  ]
}
